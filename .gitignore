/alternatives/*
!/alternatives/README.md
!/alternatives/manifest.toml

# Experiment database and raw ad-hoc runs
/results/*
!/results/.gitkeep
!/results/runs/
!/results/runs/*
!/results/dashboard.html
!/results/leaderboard.md
!/results/leaderboard.json
!/results/README.md
*.db
*.sqlite
*.sqlite3

# Models and run caches
/models/
/runs/

