# Python and local tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local secrets, keys, and credentials
.env
.env.*
!.env.example
*.key
*.pem
*.secret
credentials.json
client_secret*.json
config/providers.local.toml

# Internal agent workflows and scratchpad files
.agent/
scratch/
scratch_*.py
task_plan.md
findings.md
progress.md
docs/WORKSPACE-INVENTORY.md

